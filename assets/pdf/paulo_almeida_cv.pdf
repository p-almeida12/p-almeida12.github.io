<< /ecv-data ({"_id":"6abd47fe8922450d4921d94e","style":{"background":"","colors":["#000000","#6F7878"],"columnLayoutOption":1,"fontBody":"ptsans","fontHeading":"volkhov","fontSize":0,"headerExtraSpacing":0,"isMetaDataDisabled":false,"isSectionNameUppercase":null,"layout":"ivyleague","layoutSize":"medium","lineHeightOption":0,"marginOption":0,"pageMarginOption":1,"record":"ResumeStyle","signaturePage":null},"header":{"contacts":"","customHeight":188,"dateOfBirth":"30/01/2001","email":"p.almeida12@hotmail.com","extraField":"","extraLink":"linkedin.com/in/pauloalmeida12","height":70,"link":"p-almeida12.github.io","location":"Porto, Portugal","name":"Paulo Almeida","nationality":"Portuguese","phone":"","photo":"https://enhancv.s3.amazonaws.com/avatars/562720a5a6450daba513a0bb6a524fc1.jpg","photoStyle":"round","record":"Header","showDateOfBirth":false,"showEmail":true,"showExtraField":false,"showExtraLink":true,"showLink":true,"showLocation":true,"showNationality":false,"showPhone":false,"showPhoto":false,"showTitle":true,"title":"Backend Developer","uppercaseName":true},"sections":[{"__t":"SummarySection","column":0,"enabled":true,"height":30,"items":[{"height":78,"id":"ho6899r8cq","record":"SummaryItem","alignment":"left","text":"Backend Developer with 4+ years of experience designing and building production backend systems using Java, Spring Boot, Python, and FastAPI. Experienced in microservices, REST APIs, distributed systems, relational and NoSQL databases, and configurable business-rule engines. Currently developing backend services and APIs that integrate analytical and machine-learning capabilities into production systems. Comfortable working across international, cross-functional teams and building scalable, maintainable backend solutions."}],"name":"","record":"SummarySection","showTitle":true},{"__t":"TechnologySection","column":0,"enabled":true,"height":30,"items":[{"height":27,"id":"tnkwjsuh1b","record":"TechnologyItem","description":"","showTitle":false,"tags":["Python","FastAPI","Java","Spring","REST APIs","Microservices","MySQL","PostgreSQL","MongoDB","Docker","Nginx","Git","Azure DevOps","Prometheus","Grafana"],"title":""}],"name":"","record":"TechnologySection","layoutMode":"tags","showBulletMarker":true,"surroundingBorder":false},{"__t":"ExperienceSection","column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":8,"fromYear":2026,"isOngoing":true,"ongoingText":"","record":"DateRange","toMonth":null,"toYear":null},"table":{"cols":2,"record":"TableItem","rows":[["<b>Project name</b>","<b>Description</b>"],["",""]]},"height":169,"id":"ncef9rj90m","record":"ExperienceItem","alignment":"left","bullets":["Design and develop backend services and REST APIs using Python and FastAPI to support production applications.","Integrate analytical and machine-learning models into operational systems, exposing forecasts, recommendations, and analytical outputs through backend services.","Build and maintain APIs and services responsible for connecting ML and analytical components with downstream applications.","Support the integration of AI/ML platforms, data pipelines, and backend services across the solution.","Collaborate with ML Engineering, Data Engineering, and Architecture teams to define integrations and ensure reliable communication between distributed components."],"companyLogo":"","description":"","link":"","location":"Porto, Portugal","position":"Backend Developer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"Glintt Global"},{"dateRange":{"fromMonth":8,"fromYear":2022,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":8,"toYear":2026},"table":{"cols":2,"record":"TableItem","rows":[]},"height":169,"id":"rzmroxkrfj","record":"ExperienceItem","alignment":"left","bullets":["Designed and developed backend services and microservice-based architectures using Java 17+ and Spring Boot.","Designed and implemented a configurable rule-based engine for commercial policy management, enabling client-specific business rules to be executed dynamically rather than through hard-coded application logic.","Built and maintained REST APIs supporting business-critical workflows and integrations between internal systems and external clients.","Implemented integrations using REST APIs and SFTP-based file exchanges to support data communication across distributed systems.","Worked with relational and NoSQL databases, including MySQL and MongoDB, to support application persistence and domain requirements.","Collaborated with an international cross-functional team on backend development, system integration, and production application support."],"companyLogo":"","description":"","link":"","location":"Porto, Portugal","position":"Backend Developer","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"ePharma"},{"dateRange":{"fromMonth":3,"fromYear":2022,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":6,"toYear":2022},"table":{"cols":2,"record":"TableItem","rows":[]},"height":84,"id":"w4vyu4zc4s","record":"ExperienceItem","alignment":"left","bullets":["Developed back-office functionality for user and document management using Java and Spring.","Implemented REST endpoints and database interactions as part of existing backend services."],"companyLogo":"","description":"","link":"","location":"Porto, Portugal","position":"Backend Developer Intern","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"ePharma"}],"name":"","record":"ExperienceSection","showCompanyLogos":false,"timelineWidth":136},{"__t":"ActivitySection","column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":0,"fromYear":2024,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":0,"toYear":2025},"height":119,"id":"uervu3evsw","record":"ActivityItem","alignment":"left","bullets":["Designed and developed a backend platform using Java 21 and Spring Boot, with MySQL for relational persistence and Redis for caching.","Containerized and deployed the application using Docker on an Ubuntu server, with Nginx configured as a reverse proxy.","Implemented application monitoring and observability using Prometheus and Grafana.","Performed load and stress testing using Grafana k6 to evaluate backend performance under increasing traffic.","Used Cloudflare to improve application security, traffic management, and performance."],"description":"","link":"","location":"","showBullets":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":false,"title":"Backend Platform for Student Association Website"},{"dateRange":{"fromMonth":9,"fromYear":2023,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":9,"toYear":2025},"height":102,"id":"w7agurcbz6","record":"ActivityItem","alignment":"left","bullets":["Designed and developed a specification engine API based on a domain-specific language for configurable campaign management in the pharmaceutical domain.","Implemented dynamic execution of configurable business rules to reduce reliance on hard-coded campaign logic.","Translated domain requirements into reusable backend components supporting scalable and maintainable policy configuration.","Designed the solution with extensibility in mind, allowing business rules and configurations to evolve independently from core application logic."],"description":"","link":"","location":"","showBullets":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":false,"title":"Spec Engine API"}],"name":"","record":"ActivitySection"},{"__t":"EducationSection","column":0,"enabled":true,"height":30,"items":[{"dateRange":{"fromMonth":8,"fromYear":2022,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":9,"toYear":2025},"height":45,"id":"umgblec3b8","record":"EducationItem","alignment":"left","bullets":["Thesis: A Domain-Specific Language for Campaign Configuration in the Pharmaceutical Industry"],"companyLogo":"","degree":"Master's Degree in Biomedical Engineering","gpa":"","gpaText":"","institution":"Instituto Superior de Engenharia do Porto","location":"Porto, Portugal","maxGpa":"","showBullets":false,"showDateRange":true,"showGpa":false,"showInstitution":true,"showLocation":true},{"dateRange":{"fromMonth":8,"fromYear":2019,"isOngoing":false,"ongoingText":"","record":"DateRange","toMonth":9,"toYear":2022},"height":45,"id":"ju2iwebgtq","record":"EducationItem","alignment":"left","bullets":[],"companyLogo":"","degree":"Bachelor's Degree in Biomedical Engineering","gpa":"","gpaText":"","institution":"Instituto Superior de Engenharia do Porto","location":"Porto, Portugal","maxGpa":"","showBullets":false,"showDateRange":true,"showGpa":false,"showInstitution":true,"showLocation":true}],"name":"","record":"EducationSection","showCompanyLogos":false,"timelineWidth":136}],"user":"6abd47feef2c585d75399792"})
